{
	"name": "api",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --port 8787",
		"build": "wrangler deploy --dry-run --outdir dist",
		"deploy": "wrangler deploy",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply tktdesign --local",
		"db:migrate:remote": "wrangler d1 migrations apply tktdesign --remote",
		"secret:generate": "node scripts/generate-secret.mjs",
		"db:seed:local": "bash scripts/seed-local.sh",
		"db:seed:remote": "bash scripts/seed-remote.sh"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.4",
		"hono": "^4.11.7"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "latest",
		"drizzle-kit": "^0.31.11",
		"typescript": "^5.9.3",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	}
}
