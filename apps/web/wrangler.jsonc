{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tktdesign-web",
	"compatibility_date": "2026-10-11",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"services": [
		{
			"binding": "API",
			"service": "tktdesign-api"
		}
	]
}
